{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge Output v0.2",
  "type": "object",
  "required": [
    "case_id",
    "decision",
    "findings"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "evidence_refs",
          "policy_refs"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "refund_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "escalate_to_human": {
      "type": "boolean"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
