{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Pack v0.2",
  "type": "object",
  "required": [
    "case_id",
    "dispute_type",
    "facts",
    "policy"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dispute_type": {
      "enum": [
        "no_show_charge",
        "route_deviation"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "fact",
          "source"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "rule",
          "source"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
