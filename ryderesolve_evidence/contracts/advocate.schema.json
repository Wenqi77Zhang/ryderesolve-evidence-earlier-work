{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advocate Output v0.1",
  "type": "object",
  "required": [
    "case_id",
    "side",
    "claims"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": [
        "rider",
        "driver"
      ]
    },
    "position": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "counterpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_refs"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
